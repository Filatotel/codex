{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-resolver/execution-route.schema.json",
  "title": "EXECUTION_ROUTE",
  "type": "object",
  "required": [
    "artifact_type",
    "artifact_id",
    "produced_by_role",
    "assignment_id",
    "input_state_ref",
    "status",
    "provenance",
    "related_artifacts",
    "assignment_draft_id",
    "segments",
    "handoffs",
    "final_result_to"
  ],
  "properties": {
    "artifact_type": {
      "const": "EXECUTION_ROUTE"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "produced_by_role": {
      "type": "string",
      "minLength": 1
    },
    "assignment_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_state_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "const": "ADMISSIBLE"
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assignment_draft_id": {
      "type": "string",
      "minLength": 1
    },
    "final_result_to": {
      "type": "string",
      "minLength": 1
    },
    "segments": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "segment_id",
          "route_role",
          "destination_id",
          "runtime_identity",
          "capability_profile_ref",
          "required_capabilities",
          "execution_mode"
        ],
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "route_role": {
            "enum": [
              "CANDIDATE_DELIVERY",
              "EXECUTION_VERIFICATION",
              "DURABLE_EVIDENCE_CONTROL"
            ]
          },
          "destination_id": {
            "type": "string",
            "minLength": 1
          },
          "runtime_identity": {
            "type": "string",
            "minLength": 1
          },
          "capability_profile_ref": {
            "type": "string",
            "minLength": 1
          },
          "required_capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "execution_mode": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "handoffs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "from_segment",
          "to_segment",
          "required_capabilities",
          "same_surface"
        ],
        "properties": {
          "from_segment": {
            "type": "string",
            "minLength": 1
          },
          "to_segment": {
            "type": "string",
            "minLength": 1
          },
          "required_capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "same_surface": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
