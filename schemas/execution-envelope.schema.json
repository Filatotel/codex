{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-resolver/execution-envelope.schema.json",
  "title": "EXECUTION_ENVELOPE",
  "type": "object",
  "required": ["artifact_type", "artifact_id", "produced_by_role", "assignment_id", "input_state_ref", "status", "provenance", "related_artifacts", "supported_obligation_classes"],
  "properties": {
    "artifact_type": {"const": "EXECUTION_ENVELOPE"},
    "artifact_id": {"type": "string", "minLength": 1},
    "produced_by_role": {"const": "control-director"},
    "assignment_id": {"type": "null"},
    "input_state_ref": {"type": ["string", "null"]},
    "status": {"const": "CURRENT"},
    "provenance": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "related_artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "supported_obligation_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
