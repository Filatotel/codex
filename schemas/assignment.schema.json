{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-resolver/assignment.schema.json",
  "title": "ASSIGNMENT",
  "type": "object",
  "required": ["artifact_type","artifact_id","produced_by_role","assignment_id","input_state_ref","status","provenance","related_artifacts","objective","authority","scope","acceptance","stop_conditions","result_to"],
  "properties": {
    "artifact_type": {"const":"ASSIGNMENT"},
    "artifact_id": {"type":"string","minLength":1},
    "produced_by_role": {"type":"string","minLength":1},
    "assignment_id": {"type":"string","minLength":1},
    "input_state_ref": {"type":["string","null"]},
    "status": {"type":"string","minLength":1},
    "provenance": {"type":"array","items":{"type":"string"}},
    "related_artifacts": {"type":"array","items":{"type":"string"}},
    "objective": {"type":"string","minLength":1},
    "authority": {"type":"array","minItems":1,"items":{"type":"string"}},
    "scope": {"type":"object","required":["allowed","forbidden"],"properties":{"allowed":{"type":"array","items":{"type":"string"}},"forbidden":{"type":"array","items":{"type":"string"}}},"additionalProperties":true},
    "acceptance": {"type":"array","items":{"type":"string"}},
    "required_outputs": {"type":"array","items":{"type":"string"}},
    "stop_conditions": {"type":"array","items":{"type":"string"}},
    "result_to": {"type":"string","minLength":1}
  },
  "additionalProperties": true
}
