{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-resolver/capability-profile.schema.json",
  "title": "CAPABILITY_PROFILE",
  "type": "object",
  "required": [
    "artifact_type",
    "artifact_id",
    "produced_by_role",
    "assignment_id",
    "input_state_ref",
    "status",
    "provenance",
    "related_artifacts",
    "destination_id",
    "runtime_identity",
    "available_capabilities",
    "unavailable_capabilities",
    "capability_evidence",
    "evidence_artifacts",
    "freshness_boundary",
    "limitations"
  ],
  "properties": {
    "artifact_type": {
      "const": "CAPABILITY_PROFILE"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "produced_by_role": {
      "type": "string",
      "minLength": 1
    },
    "assignment_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_state_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "const": "CURRENT"
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "destination_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime_identity": {
      "type": "string",
      "minLength": 1
    },
    "available_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unavailable_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capability_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capability",
          "evidence_ref"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "evidence_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_type",
          "artifact_id",
          "status",
          "runtime_identity",
          "capabilities",
          "observed_at",
          "valid_until",
          "produced_by_role",
          "assignment_id",
          "input_state_ref",
          "provenance",
          "related_artifacts",
          "observation_method",
          "created_from"
        ],
        "properties": {
          "artifact_type": {
            "const": "CAPABILITY_EVIDENCE"
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "RESOLVED"
          },
          "runtime_identity": {
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
          },
          "produced_by_role": {
            "type": "string",
            "minLength": 1
          },
          "assignment_id": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "input_state_ref": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "related_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observation_method": {
            "type": "string",
            "minLength": 1
          },
          "created_from": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "freshness_boundary": {
      "type": "object",
      "required": [
        "observed_at",
        "valid_until"
      ],
      "properties": {
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
