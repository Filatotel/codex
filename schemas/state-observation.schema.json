{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-resolver/state-observation.schema.json",
  "title": "STATE_OBSERVATION",
  "type": "object",
  "required": ["artifact_type", "artifact_id", "produced_by_role", "input_state_ref", "status", "provenance", "related_artifacts", "state_identity", "authority_scope"],
  "properties": {
    "artifact_type": {"const": "STATE_OBSERVATION"},
    "artifact_id": {"type": "string", "minLength": 1},
    "produced_by_role": {"const": "control-director"},
    "input_state_ref": {"type": ["string", "null"]},
    "status": {"const": "CURRENT"},
    "provenance": {"type": "array", "items": {"type": "string"}},
    "related_artifacts": {"type": "array", "items": {"type": "string"}},
    "state_identity": {"type": "string", "minLength": 1},
    "authority_scope": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
