{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-resolver/research-chain-reconciliation.schema.json",
  "title": "RESEARCH_CHAIN_RECONCILIATION",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifact_id",
    "produced_by_role",
    "assignment_id",
    "input_state_ref",
    "status",
    "provenance",
    "related_artifacts",
    "project_id",
    "chain_id",
    "upstream_research_refs",
    "requirement_evaluations",
    "unresolved_gaps",
    "evidence_ceilings",
    "supersessions",
    "satisfied_requirement_refs",
    "blocked_requirement_refs",
    "next_research_frontier",
    "owner_input_required",
    "no_further_research_justified",
    "research_execution_authority",
    "direct_dispatch_authority",
    "canon_mutation_authority"
  ],
  "properties": {
    "artifact_type": {"const": "RESEARCH_CHAIN_RECONCILIATION"},
    "artifact_id": {"type": "string", "minLength": 1},
    "produced_by_role": {"type": "string", "minLength": 1},
    "assignment_id": {"type": ["string", "null"]},
    "input_state_ref": {"type": "string", "minLength": 1},
    "status": {"enum": ["RECONCILED", "PARTIAL", "BLOCKED", "OWNER_DECISION_REQUIRED", "NO_FURTHER_RESEARCH", "SUPERSEDED"]},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "related_artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "project_id": {"type": "string", "minLength": 1},
    "chain_id": {"type": "string", "minLength": 1},
    "upstream_research_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "requirement_evaluations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement_evaluation"}},
    "unresolved_gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
    "evidence_ceilings": {"type": "array", "items": {"$ref": "#/$defs/evidence_ceiling"}},
    "supersessions": {"type": "array", "items": {"$ref": "#/$defs/supersession"}},
    "satisfied_requirement_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "blocked_requirement_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "next_research_frontier": {"type": "array", "items": {"$ref": "#/$defs/frontier_candidate"}},
    "owner_input_required": {"type": "boolean"},
    "no_further_research_justified": {"type": "boolean"},
    "research_execution_authority": {"const": false},
    "direct_dispatch_authority": {"const": false},
    "canon_mutation_authority": {"const": false}
  },
  "$defs": {
    "requirement_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_ref", "state", "supporting_research_refs", "gap_refs", "rationale"],
      "properties": {
        "requirement_ref": {"type": "string", "minLength": 1},
        "state": {"enum": ["SATISFIED", "BLOCKED", "ACCEPTABLE_UNKNOWN", "EVIDENCE_CEILING", "OWNER_DECISION_REQUIRED", "SUPERSEDED", "DEFERRED", "OUT_OF_SCOPE"]},
        "supporting_research_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "gap_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gap_id", "requirement_ref", "classification", "source_research_refs", "description", "active", "continuation"],
      "properties": {
        "gap_id": {"type": "string", "minLength": 1},
        "requirement_ref": {"type": "string", "minLength": 1},
        "classification": {"enum": ["CONSEQUENTIAL_BLOCKER", "ACCEPTABLE_UNKNOWN", "EVIDENCE_CEILING", "SUPERSEDED_REQUIREMENT", "OWNER_PREFERENCE_OR_AUTHORITY", "METHOD_OR_ARTIFACT_DEFECT", "OUTSIDE_CURRENT_SCOPE", "BOUNDED_NEW_RESEARCH_CANDIDATE"]},
        "source_research_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "description": {"type": "string", "minLength": 1},
        "active": {"type": "boolean"},
        "continuation": {"enum": ["NO_RESEARCH", "DEFER", "OWNER_GATE", "REDESIGN_DOWNSTREAM_REQUIREMENT", "BOUNDED_NEW_RESEARCH_CANDIDATE"]}
      }
    },
    "evidence_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ceiling_id", "requirement_ref", "supporting_research_refs", "reason", "disposition", "further_research_justified"],
      "properties": {
        "ceiling_id": {"type": "string", "minLength": 1},
        "requirement_ref": {"type": "string", "minLength": 1},
        "supporting_research_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "reason": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["ACCEPT_BOUNDED_UNCERTAINTY", "DEFER", "OWNER_GATE", "REDESIGN_DOWNSTREAM_REQUIREMENT", "STOP_RESEARCH_LANE"]},
        "further_research_justified": {"const": false}
      }
    },
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["superseded_ref", "superseded_by_ref", "reason", "active_authority"],
      "properties": {
        "superseded_ref": {"type": "string", "minLength": 1},
        "superseded_by_ref": {"type": ["string", "null"]},
        "reason": {"type": "string", "minLength": 1},
        "active_authority": {"const": false}
      }
    },
    "frontier_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "requirement_ref", "question", "justification", "prior_gap_ref", "narrowed_by_evidence_refs", "method_available", "evidence_ceiling_absent", "owner_preference_absent", "dispatch_status"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "requirement_ref": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "justification": {"type": "string", "minLength": 1},
        "prior_gap_ref": {"type": "string", "minLength": 1},
        "narrowed_by_evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "method_available": {"const": true},
        "evidence_ceiling_absent": {"const": true},
        "owner_preference_absent": {"const": true},
        "dispatch_status": {"const": "CANDIDATE_ONLY"}
      }
    }
  }
}
