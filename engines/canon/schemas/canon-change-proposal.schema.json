{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-resolver/canon-change-proposal.schema.json",
  "title": "CANON_CHANGE_PROPOSAL",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "artifact_id", "produced_by_role", "assignment_id", "input_state_ref", "status", "provenance", "related_artifacts", "project_id", "prior_canon_ref", "change_id", "change_class", "statement", "scope", "authority_required", "evidence_refs", "downstream_revalidation"],
  "properties": {
    "artifact_type": {"const": "CANON_CHANGE_PROPOSAL"},
    "artifact_id": {"type": "string", "minLength": 1},
    "produced_by_role": {"type": "string", "minLength": 1},
    "assignment_id": {"type": ["string", "null"]},
    "input_state_ref": {"type": "string", "minLength": 1},
    "status": {"enum": ["PROPOSED", "ACCEPTED", "BLOCKED", "SUPERSEDED"]},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "related_artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "project_id": {"type": "string", "minLength": 1},
    "prior_canon_ref": {"type": "string", "minLength": 1},
    "change_id": {"type": "string", "minLength": 1},
    "change_class": {"enum": ["A_ENRICHMENT", "B_CLOSURE", "C_PRODUCTION_REQUIRED_CANONICAL_CHANGE", "D_CORE_CHANGE_RETCON", "RESEARCH_RECONCILIATION", "FINAL_RECONCILIATION", "REOPEN"]},
    "statement": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "authority_required": {"type": "string", "minLength": 1},
    "authority_ref": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "downstream_revalidation": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "ACCEPTED"}}}, "then": {"properties": {"authority_ref": {"type": "string", "minLength": 1}}, "required": ["authority_ref"]}}
  ]
}
