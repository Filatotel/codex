{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-resolver/canon-reconciliation-result.schema.json",
  "title": "CANON_RECONCILIATION_RESULT",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "artifact_id", "produced_by_role", "assignment_id", "input_state_ref", "status", "provenance", "related_artifacts", "project_id", "source_canon_ref", "research_release_refs", "dispositions", "change_proposal_refs", "mutation_authority_ref"],
  "properties": {
    "artifact_type": {"const": "CANON_RECONCILIATION_RESULT"},
    "artifact_id": {"type": "string", "minLength": 1},
    "produced_by_role": {"type": "string", "minLength": 1},
    "assignment_id": {"type": ["string", "null"]},
    "input_state_ref": {"type": "string", "minLength": 1},
    "status": {"enum": ["PROPOSED", "READY_FOR_AUTHORITY", "ACCEPTED", "BLOCKED", "SUPERSEDED"]},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "related_artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "project_id": {"type": "string", "minLength": 1},
    "source_canon_ref": {"type": "string", "minLength": 1},
    "research_release_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "dispositions": {"type": "array", "items": {"$ref": "#/$defs/disposition"}},
    "change_proposal_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "mutation_authority_ref": {"type": ["string", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "ACCEPTED"}}}, "then": {"properties": {"mutation_authority_ref": {"type": "string", "minLength": 1}}, "required": ["mutation_authority_ref"]}}
  ],
  "$defs": {
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "disposition", "canon_entry_refs", "reason", "authority_ref"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["NO_CHANGE", "PROPOSE_CHANGE", "ACCEPT_AUTHORIZED_CHANGE", "PRESERVE_UNKNOWN", "PRESERVE_AMBIGUITY", "PRESERVE_CONTRADICTION", "BLOCKED"]},
        "canon_entry_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 1},
        "authority_ref": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"disposition": {"const": "ACCEPT_AUTHORIZED_CHANGE"}}}, "then": {"properties": {"authority_ref": {"type": "string", "minLength": 1}}, "required": ["authority_ref"]}}
      ]
    }
  }
}
