{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-resolver.local/schemas/canon-state.schema.json",
  "title": "Project Resolver Canon State",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "project_id", "canon_version", "maturity", "status", "authority", "entries", "freeze", "change_history"],
  "properties": {
    "artifact_type": {"const": "CANON_STATE"},
    "project_id": {"type": "string", "minLength": 1},
    "canon_version": {"type": "string", "pattern": "^[12]\\.[0-9]+(?:\\.[0-9]+)?$"},
    "maturity": {"enum": ["CANON_1_0", "CANON_2_0", "REOPENED"]},
    "status": {"enum": ["PROPOSED", "ACCEPTED", "FROZEN", "SUPERSEDED"]},
    "authority": {"$ref": "#/$defs/authority"},
    "foundation_ref": {"type": "string"},
    "research_release_ref": {"type": ["string", "null"]},
    "reconciliation_ref": {"type": ["string", "null"]},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "freeze": {"$ref": "#/$defs/freeze"},
    "change_history": {"type": "array", "items": {"$ref": "#/$defs/change"}}
  },
  "$defs": {
    "authority": {"type": "object", "additionalProperties": false, "required": ["holder", "scope", "source_ref"], "properties": {"holder": {"type": "string"}, "scope": {"type": "string"}, "source_ref": {"type": "string"}}},
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "statement", "status", "scope", "provenance", "authority_ref"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["PROTECTED_VALUE", "FACT", "ASSUMPTION", "UNKNOWN", "AMBIGUITY", "CONTRADICTION", "DECISION"]},
        "statement": {"type": "string", "minLength": 1},
        "status": {"enum": ["PROPOSED", "ACCEPTED", "FROZEN", "SUPERSEDED"]},
        "scope": {"type": "string", "minLength": 1},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "authority_ref": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "metadata": {"type": "object"}
      }
    },
    "freeze": {"type": "object", "additionalProperties": false, "required": ["state", "scope"], "properties": {"state": {"enum": ["OPEN", "FROZEN"]}, "scope": {"type": "string"}, "freeze_record_ref": {"type": ["string", "null"]}}},
    "change": {"type": "object", "additionalProperties": false, "required": ["change_id", "class", "prior_state_ref", "result_state_ref", "authority_ref"], "properties": {"change_id": {"type": "string"}, "class": {"enum": ["A_ENRICHMENT", "B_CLOSURE", "C_PRODUCTION_REQUIRED_CANONICAL_CHANGE", "D_CORE_CHANGE_RETCON", "RESEARCH_RECONCILIATION", "FINAL_RECONCILIATION", "REOPEN"]}, "prior_state_ref": {"type": "string"}, "result_state_ref": {"type": "string"}, "authority_ref": {"type": "string"}, "reason_ref": {"type": "string"}}}
  }
}
