{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-resolver.local/schemas/canon-foundation.schema.json",
  "title": "Project Resolver Canon Foundation",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "project_id", "canon_version", "status", "authority", "protected_values", "facts", "assumptions", "unknowns", "ambiguities", "contradictions", "decisions", "freeze"],
  "properties": {
    "artifact_type": {"const": "CANON_FOUNDATION"},
    "project_id": {"type": "string", "minLength": 1},
    "canon_version": {"type": "string", "pattern": "^0\\.[0-9]+(?:\\.[0-9]+)?$"},
    "status": {"enum": ["PROPOSED", "ACCEPTED", "FROZEN", "SUPERSEDED"]},
    "authority": {"$ref": "#/$defs/authority"},
    "source_refs": {"type": "array", "items": {"type": "string"}, "default": []},
    "protected_values": {"type": "array", "items": {"$ref": "#/$defs/governedRecord"}},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/governedRecord"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
    "unknowns": {"type": "array", "items": {"$ref": "#/$defs/unknown"}},
    "ambiguities": {"type": "array", "items": {"$ref": "#/$defs/ambiguity"}},
    "contradictions": {"type": "array", "items": {"$ref": "#/$defs/contradiction"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/governedRecord"}},
    "freeze": {"$ref": "#/$defs/freeze"}
  },
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holder", "scope", "source_ref"],
      "properties": {"holder": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "source_ref": {"type": "string", "minLength": 1}}
    },
    "governedRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "status", "scope", "provenance", "authority_ref"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1},
        "status": {"enum": ["PROPOSED", "ACCEPTED", "FROZEN", "SUPERSEDED"]}, "scope": {"type": "string", "minLength": 1},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "authority_ref": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "items": {"type": "string"}, "default": []}
      }
    },
    "assumption": {
      "allOf": [{"$ref": "#/$defs/governedRecord"}, {"type": "object", "properties": {"reason": {"type": "string"}, "risk_if_false": {"type": "string"}, "resolution_path": {"type": "string"}}}]
    },
    "unknown": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "question", "scope", "blocking", "provenance"],
      "properties": {"id": {"type": "string", "minLength": 1}, "question": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "blocking": {"type": "boolean"}, "provenance": {"type": "array", "items": {"type": "string"}}, "resolution_path": {"type": "string"}}
    },
    "ambiguity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "status", "scope", "authority_ref", "provenance", "preservation_requirements"],
      "properties": {"id": {"type": "string"}, "statement": {"type": "string"}, "status": {"enum": ["PROPOSED", "ACCEPTED", "FROZEN", "SUPERSEDED"]}, "scope": {"type": "string"}, "authority_ref": {"type": "string"}, "provenance": {"type": "array", "items": {"type": "string"}}, "allowed_readings": {"type": "array", "items": {"type": "string"}}, "forbidden_collapses": {"type": "array", "items": {"type": "string"}}, "preservation_requirements": {"type": "array", "items": {"type": "string"}}}
    },
    "contradiction": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "class", "involved_refs", "scope", "blocking", "provenance"],
      "properties": {"id": {"type": "string"}, "class": {"enum": ["DIRECT", "TEMPORAL", "IDENTITY", "TERMINOLOGY", "DEPENDENCY", "INTENTIONAL_TENSION", "SCOPED_APPARENT_CONFLICT", "NONBLOCKING_DUPLICATION", "NEEDS_AUTHORITY"]}, "involved_refs": {"type": "array", "minItems": 2, "items": {"type": "string"}}, "scope": {"type": "string"}, "blocking": {"type": "boolean"}, "provenance": {"type": "array", "items": {"type": "string"}}}
    },
    "freeze": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "scope"],
      "properties": {"state": {"enum": ["OPEN", "FROZEN"]}, "scope": {"type": "string"}, "freeze_record_ref": {"type": ["string", "null"]}}
    }
  }
}
