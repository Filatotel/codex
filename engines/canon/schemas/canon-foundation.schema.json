{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-resolver/canon-foundation.schema.json",
  "title": "CANON_FOUNDATION",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "artifact_id", "produced_by_role", "assignment_id", "input_state_ref", "status", "provenance", "related_artifacts", "project_id", "canon_version", "authority", "protected_values", "facts", "assumptions", "unknowns", "ambiguities", "contradictions", "decisions", "freeze"],
  "properties": {
    "artifact_type": {"const": "CANON_FOUNDATION"},
    "artifact_id": {"type": "string", "minLength": 1},
    "produced_by_role": {"type": "string", "minLength": 1},
    "assignment_id": {"type": ["string", "null"]},
    "input_state_ref": {"type": "string", "minLength": 1},
    "status": {"enum": ["PROPOSED", "ACCEPTED", "FROZEN", "SUPERSEDED"]},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "related_artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "project_id": {"type": "string", "minLength": 1},
    "canon_version": {"type": "string", "pattern": "^0\\.[0-9]+(?:\\.[0-9]+)?$"},
    "authority": {"$ref": "#/$defs/authority"},
    "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "protected_values": {"type": "array", "items": {"$ref": "#/$defs/governedRecord"}},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/governedRecord"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
    "unknowns": {"type": "array", "items": {"$ref": "#/$defs/unknown"}},
    "ambiguities": {"type": "array", "items": {"$ref": "#/$defs/ambiguity"}},
    "contradictions": {"type": "array", "items": {"$ref": "#/$defs/contradiction"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/governedRecord"}},
    "freeze": {"$ref": "#/$defs/freeze"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "FROZEN"}}},
      "then": {"properties": {"freeze": {"type": "object", "required": ["state", "freeze_record_ref"], "properties": {"state": {"const": "FROZEN"}, "freeze_record_ref": {"type": "string", "minLength": 1}}}}}
    },
    {
      "if": {"properties": {"freeze": {"type": "object", "required": ["state"], "properties": {"state": {"const": "FROZEN"}}}}},
      "then": {"properties": {"status": {"const": "FROZEN"}, "freeze": {"type": "object", "required": ["freeze_record_ref"], "properties": {"freeze_record_ref": {"type": "string", "minLength": 1}}}}}
    }
  ],
  "$defs": {
    "authority": {"type": "object", "additionalProperties": false, "required": ["holder", "scope", "source_ref"], "properties": {"holder": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "source_ref": {"type": "string", "minLength": 1}}},
    "governedRecord": {"type": "object", "additionalProperties": false, "required": ["id", "statement", "status", "scope", "provenance", "authority_ref"], "properties": {"id": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "status": {"enum": ["PROPOSED", "ACCEPTED", "FROZEN", "SUPERSEDED"]}, "scope": {"type": "string", "minLength": 1}, "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "authority_ref": {"type": "string", "minLength": 1}, "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "assumption": {"type": "object", "additionalProperties": false, "required": ["id", "statement", "status", "scope", "provenance", "authority_ref", "reason", "risk_if_false"], "properties": {"id": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "status": {"enum": ["PROPOSED", "ACCEPTED", "FROZEN", "SUPERSEDED"]}, "scope": {"type": "string", "minLength": 1}, "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "authority_ref": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "risk_if_false": {"type": "string", "minLength": 1}, "resolution_path": {"type": "string"}, "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "unknown": {"type": "object", "additionalProperties": false, "required": ["id", "question", "scope", "blocking", "provenance"], "properties": {"id": {"type": "string", "minLength": 1}, "question": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "blocking": {"type": "boolean"}, "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "resolution_path": {"type": "string"}}},
    "ambiguity": {"type": "object", "additionalProperties": false, "required": ["id", "statement", "status", "scope", "authority_ref", "provenance", "preservation_requirements"], "properties": {"id": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "status": {"enum": ["PROPOSED", "ACCEPTED", "FROZEN", "SUPERSEDED"]}, "scope": {"type": "string", "minLength": 1}, "authority_ref": {"type": "string", "minLength": 1}, "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "allowed_readings": {"type": "array", "items": {"type": "string"}}, "forbidden_collapses": {"type": "array", "items": {"type": "string"}}, "preservation_requirements": {"type": "array", "items": {"type": "string"}}}},
    "contradiction": {"type": "object", "additionalProperties": false, "required": ["id", "class", "involved_refs", "scope", "blocking", "provenance"], "properties": {"id": {"type": "string", "minLength": 1}, "class": {"enum": ["DIRECT", "TEMPORAL", "IDENTITY", "TERMINOLOGY", "DEPENDENCY", "INTENTIONAL_TENSION", "SCOPED_APPARENT_CONFLICT", "NONBLOCKING_DUPLICATION", "NEEDS_AUTHORITY"]}, "involved_refs": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}, "scope": {"type": "string", "minLength": 1}, "blocking": {"type": "boolean"}, "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "freeze": {"type": "object", "additionalProperties": false, "required": ["state", "scope"], "properties": {"state": {"enum": ["OPEN", "FROZEN"]}, "scope": {"type": "string", "minLength": 1}, "freeze_record_ref": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}}}
  }
}
