{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-resolver/foundation/topology-bootstrap.schema.json",
  "title": "PROJECT_TOPOLOGY_BOOTSTRAP",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "plan",
    "manifest",
    "index",
    "shell"
  ],
  "properties": {
    "kind": {
      "const": "PROJECT_TOPOLOGY_BOOTSTRAP"
    },
    "version": {
      "const": 1
    },
    "plan": {
      "$ref": "topology-plan.schema.json"
    },
    "manifest": {
      "type": "object"
    },
    "index": {
      "type": "object"
    },
    "shell": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
