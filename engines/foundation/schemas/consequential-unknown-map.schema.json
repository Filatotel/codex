{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-resolver/foundation/consequential-unknown-map.schema.json",
  "title": "CONSEQUENTIAL_UNKNOWN_MAP",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifact_id",
    "produced_by_role",
    "assignment_id",
    "input_state_ref",
    "status",
    "provenance",
    "related_artifacts",
    "authoritative",
    "items"
  ],
  "properties": {
    "artifact_type": {"const": "CONSEQUENTIAL_UNKNOWN_MAP"},
    "artifact_id": {"type": "string", "minLength": 1},
    "produced_by_role": {"type": "string", "minLength": 1},
    "assignment_id": {"type": ["string", "null"]},
    "input_state_ref": {"type": "string", "minLength": 1},
    "status": {"const": "WORKING"},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "related_artifacts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authoritative": {"const": false},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "classification", "why_it_matters", "state"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "classification": {
            "enum": [
              "OWNER_PREFERENCE",
              "EXTERNAL_FACT",
              "FEASIBILITY",
              "ARCHITECTURE_DECISION",
              "IMPLEMENTATION_DEPENDENT",
              "NICE_TO_KNOW"
            ]
          },
          "why_it_matters": {"type": "string", "minLength": 1},
          "state": {"enum": ["OPEN", "DEFERRED"]},
          "related_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
